---
// Clean line icons for tiles, drawn on a 24×24 grid in the current text colour.
import type { LineIconName } from "../data/site";

interface Props {
    name: LineIconName;
    class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
>
    {name === "laptop" && (
        <Fragment>
            <rect x="4" y="5" width="16" height="11" rx="1.5" />
            <path d="M2 19h20" />
        </Fragment>
    )}
    {name === "ticket" && (
        <Fragment>
            <path d="M3 7h18v3a2 2 0 0 0 0 4v3H3v-3a2 2 0 0 0 0-4z" />
            <path d="M15 7v2M15 11v2M15 15v2" />
        </Fragment>
    )}
    {name === "book" && (
        <Fragment>
            <path d="M12 7v13" />
            <path d="M3 5h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5v12h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3H3z" />
        </Fragment>
    )}
    {name === "star" && (
        <polygon points="12,3 14.35,9.26 21.04,9.56 15.8,13.74 17.58,20.19 12,16.5 6.42,20.19 8.2,13.74 2.96,9.56 9.65,9.26" />
    )}
    {name === "heart" && (
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z" />
    )}
    {name === "calendar" && (
        <Fragment>
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M3 10h18M8 3v4M16 3v4" />
        </Fragment>
    )}
    {name === "users" && (
        <Fragment>
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20a6.5 6.5 0 0 1 13 0" />
            <path d="M16 4.5a3.5 3.5 0 0 1 0 7" />
            <path d="M18 14.5a6.5 6.5 0 0 1 3.5 5.5" />
        </Fragment>
    )}
    {name === "clipboard" && (
        <Fragment>
            <rect x="8" y="2" width="8" height="4" rx="1" />
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
            <path d="M9 12h6M9 16h4" />
        </Fragment>
    )}
    {name === "gift" && (
        <Fragment>
            <rect x="3" y="8" width="18" height="4" rx="1" />
            <path d="M12 8v13" />
            <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
            <path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5" />
        </Fragment>
    )}
</svg>
