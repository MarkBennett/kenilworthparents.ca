---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import SchoolLinked from "../components/SchoolLinked.astro";
import FundraiserList from "../components/FundraiserList.astro";

const { mission, presidentMessage } = site;
---

<Layout>
    <section class="border-b border-border bg-surface pt-12 pb-8" aria-labelledby="page-title">
        <div class="mx-auto w-full max-w-page px-5">
            <h1 id="page-title" class="mb-3 text-3xl/tight font-bold md:text-4xl/tight">
                {site.name}
            </h1>
            <p class="max-w-180 text-lg text-muted">{site.description}</p>
        </div>
    </section>

    <div class="mx-auto w-full max-w-page px-5">
        <section id="mission" class="pt-10" aria-labelledby="mission-heading">
            <h2 id="mission-heading" class="mb-4 text-2xl/tight font-bold">Our Mission</h2>
            <p><SchoolLinked text={mission} /></p>
        </section>

        <section
            class="mt-10 flex items-start gap-4 rounded-lg border border-border bg-surface p-6"
            aria-labelledby="president-message-heading"
        >
            <Image
                src={presidentMessage.photo}
                alt=""
                width={48}
                height={48}
                densities={[1, 2, 3]}
                class="size-12 flex-none rounded-full object-cover"
            />
            <div>
                <h2 id="president-message-heading" class="mb-2 text-2xl/tight font-bold">
                    A message from our president
                </h2>
                <p>{presidentMessage.message}</p>
                <p class="mt-4 grid text-sm text-muted">
                    <span class="font-semibold text-primary-dark">{presidentMessage.name}</span>
                    <span>
                        {presidentMessage.title}, {site.name}
                    </span>
                </p>
            </div>
        </section>

        <section id="fundraisers" class="pt-10" aria-labelledby="fundraisers-heading">
            <h2 id="fundraisers-heading" class="mb-4 text-2xl/tight font-bold">Active Fundraisers</h2>
            <FundraiserList />
            <p class="mt-4">
                <a href="/fundraisers">See all fundraising details</a>
            </p>
        </section>
    </div>
</Layout>
