---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import logo from "../assets/logo.png";

const { mission, presidentMessage, contact, mailingAddress, fundraisers } =
    site;
const cityLine = [
    `${mailingAddress.city}, ${mailingAddress.province}`,
    mailingAddress.postalCode,
]
    .filter(Boolean)
    .join(" ");
---

<Layout>
    <section class="border-b border-border bg-surface pt-12 pb-8" aria-labelledby="page-title">
        <div class="mx-auto flex w-full max-w-page flex-col items-start gap-6 px-5 md:flex-row">
            <Image
                src={logo}
                alt={`${site.shortName} logo`}
                width={200}
                height={200}
                class="h-auto w-full max-w-50 flex-none self-center md:w-36 md:self-start"
                loading="eager"
            />
            <div>
                <h1 id="page-title" class="mb-3 text-3xl/tight font-bold md:text-4xl/tight">
                    {site.name}
                </h1>
                <p class="max-w-180 text-lg text-muted">{site.description}</p>
            </div>
        </div>
    </section>

    <div class="mx-auto w-full max-w-page px-5">
        <section id="mission" class="pt-10" aria-labelledby="mission-heading">
            <h2 id="mission-heading" class="mb-4 text-2xl/tight font-bold">Our Mission</h2>
            <p>{mission}</p>
        </section>

        <section
            class="mt-10 flex items-start gap-4 rounded-lg border border-border bg-surface p-6"
            aria-labelledby="president-message-heading"
        >
            <Image
                src={presidentMessage.photo}
                alt=""
                width={48}
                height={48}
                densities={[1, 2, 3]}
                class="size-12 flex-none rounded-full object-cover"
            />
            <div>
                <h2 id="president-message-heading" class="mb-2 text-2xl/tight font-bold">
                    A message from our president
                </h2>
                <p>{presidentMessage.message}</p>
                <p class="mt-4 grid text-sm text-muted">
                    <span class="font-semibold text-primary-dark">{presidentMessage.name}</span>
                    <span>
                        {presidentMessage.title}, {site.name}
                    </span>
                </p>
            </div>
        </section>

        <section id="fundraisers" class="pt-10" aria-labelledby="fundraisers-heading">
            <h2 id="fundraisers-heading" class="mb-4 text-2xl/tight font-bold">Active Fundraisers</h2>
            {fundraisers.length > 0 ? (
                <ul class="grid gap-4" role="list">
                    {fundraisers.map((fundraiser) => (
                        <li class="rounded-lg border border-border bg-white p-5">
                            <article class="space-y-2">
                                <h3 class="text-lg/tight font-bold">{fundraiser.name}</h3>
                                {fundraiser.dates && (
                                    <p class="font-semibold text-muted">{fundraiser.dates}</p>
                                )}
                                <p>{fundraiser.description}</p>
                                {fundraiser.url && (
                                    <p>
                                        <a href={fundraiser.url}>
                                            Learn more
                                            <span class="sr-only">
                                                {" "}
                                                about {fundraiser.name}
                                            </span>
                                        </a>
                                    </p>
                                )}
                            </article>
                        </li>
                    ))}
                </ul>
            ) : (
                <p>
                    There are no active fundraisers right now. Please check back
                    soon.
                </p>
            )}
        </section>

        <section id="contact" class="pt-10" aria-labelledby="contact-heading">
            <h2 id="contact-heading" class="mb-4 text-2xl/tight font-bold">Contact Us</h2>
            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <h3 class="mb-2 text-lg/tight font-bold">Email</h3>
                    <p>
                        <a href={`mailto:${contact.email}`}>{contact.email}</a>
                    </p>
                </div>
                <div>
                    <h3 class="mb-2 text-lg/tight font-bold">Mailing Address</h3>
                    <address class="not-italic">
                        {mailingAddress.recipient}
                        <br />
                        {mailingAddress.lines.map((line) => (
                            <Fragment>
                                {line}
                                <br />
                            </Fragment>
                        ))}
                        {cityLine}
                        <br />
                        {mailingAddress.country}
                    </address>
                </div>
            </div>
        </section>
    </div>
</Layout>
