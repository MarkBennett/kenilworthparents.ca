---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import IconTile from "../components/IconTile.astro";

const { waysToHelp } = site;
---

<Layout title={`Get Involved | ${site.name}`}>
    <section class="border-b border-border bg-surface pt-12 pb-8" aria-labelledby="page-title">
        <div class="mx-auto w-full max-w-page px-5">
            <h1 id="page-title" class="mb-3 text-3xl/tight font-bold md:text-4xl/tight">
                Get Involved
            </h1>
            <p class="max-w-180 text-lg text-muted">
                Every bit of time and support helps Kenilworth students. Here are the easiest ways
                to help.
            </p>
        </div>
    </section>

    <div class="mx-auto w-full max-w-page px-5">
        <ul class="grid gap-5 pt-10 sm:grid-cols-2" role="list">
            {waysToHelp.map((way) => <IconTile {...way} />)}
        </ul>
    </div>
</Layout>
