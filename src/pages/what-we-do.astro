---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import SchoolLinked from "../components/SchoolLinked.astro";
import SupportIcon from "../components/SupportIcon.astro";

const { mission, supportAreas } = site;
---

<Layout title={`What We Do | ${site.name}`}>
    <section class="border-b border-border bg-surface pt-12 pb-8" aria-labelledby="page-title">
        <div class="mx-auto w-full max-w-page px-5">
            <h1 id="page-title" class="mb-3 text-3xl/tight font-bold md:text-4xl/tight">
                What We Do
            </h1>
            <p class="max-w-180 text-lg text-muted"><SchoolLinked text={mission} /></p>
        </div>
    </section>

    <div class="mx-auto w-full max-w-page px-5">
        <ul class="grid gap-5 pt-10 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {supportAreas.map((area) => (
                <li class="rounded-lg border border-border bg-white p-6">
                    <article>
                        <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-primary text-white">
                            <SupportIcon name={area.icon} class="size-8" />
                        </div>
                        <h2 class="text-xl/tight font-bold">{area.name}</h2>
                        {area.figure && (
                            <p class="mt-2 inline-block rounded-full bg-surface px-3 py-0.5 text-sm font-semibold text-primary-dark">
                                {area.figure}
                            </p>
                        )}
                        <p class="mt-2 text-muted">{area.description}</p>
                    </article>
                </li>
            ))}
        </ul>

        <section
            class="mt-10 rounded-lg bg-surface p-6 text-center"
            aria-labelledby="fundraisers-cta-heading"
        >
            <h2 id="fundraisers-cta-heading" class="mb-4 text-xl/tight font-bold">
                Our fundraisers make all of this possible.
            </h2>
            <a
                href="/fundraisers"
                class="inline-block rounded-lg bg-primary px-5 py-2.5 font-semibold text-white no-underline hover:bg-primary-dark hover:text-white"
            >
                See our fundraisers
            </a>
        </section>
    </div>
</Layout>
