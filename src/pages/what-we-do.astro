---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import SchoolLinked from "../components/SchoolLinked.astro";
import IconTile from "../components/IconTile.astro";
import ButtonLink from "../components/ButtonLink.astro";

const { mission, supportAreas } = site;
---

<Layout title={`What We Do | ${site.name}`}>
    <section class="border-b border-border bg-surface pt-12 pb-8" aria-labelledby="page-title">
        <div class="mx-auto w-full max-w-page px-5">
            <h1 id="page-title" class="mb-3 text-3xl/tight font-bold md:text-4xl/tight">
                What We Do
            </h1>
            <p class="max-w-180 text-lg text-muted"><SchoolLinked text={mission} /></p>
        </div>
    </section>

    <div class="mx-auto w-full max-w-page px-5">
        <ul class="grid gap-5 pt-10 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {supportAreas.map((area) => <IconTile {...area} />)}
        </ul>

        <section
            class="mt-10 rounded-lg bg-surface p-6 text-center"
            aria-labelledby="fundraisers-cta-heading"
        >
            <h2 id="fundraisers-cta-heading" class="mb-4 text-xl/tight font-bold">
                Our fundraisers and volunteers make all of this possible.
            </h2>
            <div class="flex flex-wrap justify-center gap-3">
                <ButtonLink href="/fundraisers">See our fundraisers</ButtonLink>
                <ButtonLink href="/get-involved" variant="secondary">Get involved</ButtonLink>
            </div>
        </section>
    </div>
</Layout>
