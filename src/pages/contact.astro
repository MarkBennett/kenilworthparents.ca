---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import MailingAddress from "../components/MailingAddress.astro";

const { contact } = site;
---

<Layout title={`Contact Us | ${site.name}`}>
    <section class="border-b border-border bg-surface pt-12 pb-8" aria-labelledby="page-title">
        <div class="mx-auto w-full max-w-page px-5">
            <h1 id="page-title" class="mb-3 text-3xl/tight font-bold md:text-4xl/tight">
                Contact Us
            </h1>
            <p class="max-w-180 text-lg text-muted">
                Questions, ideas, or want to volunteer? We’d love to hear from you.
            </p>
            <p class="mt-3 max-w-180 text-muted">
                The KPA is independent of the school. For questions about your child or
                school matters, please contact{" "}
                <a href={site.school.url}>{site.school.name}</a> directly.
            </p>
        </div>
    </section>

    <div class="mx-auto w-full max-w-page px-5">
        <div class="grid gap-6 pt-10 sm:grid-cols-2">
            <section aria-labelledby="email-heading">
                <h2 id="email-heading" class="mb-2 text-2xl/tight font-bold">Email</h2>
                <p>
                    <a href={`mailto:${contact.email}`}>{contact.email}</a>
                </p>
            </section>
            <section aria-labelledby="mailing-address-heading">
                <h2 id="mailing-address-heading" class="mb-2 text-2xl/tight font-bold">
                    Mailing Address
                </h2>
                <MailingAddress />
            </section>
        </div>
    </div>
</Layout>
