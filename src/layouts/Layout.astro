---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-CA" class="motion-safe:scroll-smooth tall:scroll-pt-[var(--header-height,4rem)]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="absolute -top-12 left-4 z-100 rounded-lg bg-primary-dark px-4 py-2 text-white focus:top-4"
      href="#main"
    >
      Skip to main content
    </a>

    <header class="top-0 z-50 bg-primary-dark text-white tall:sticky">
      <div
        class="mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4"
      >
        <a class="text-lg font-bold text-white no-underline hover:underline" href="/">
          <span class="md:hidden">{site.shortName}</span>
          <span class="hidden md:inline">{site.name}</span>
        </a>
        <nav aria-label="Primary">
          <ul class="flex flex-wrap gap-x-5 gap-y-1 [&_a]:text-white [&_a:hover]:decoration-2">
            <li><a href="#mission">Mission</a></li>
            <li><a href="#fundraisers">Fundraisers</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <footer class="mt-12 border-t border-border bg-surface py-6 text-sm text-muted">
      <div class="mx-auto w-full max-w-page px-5">
        <p>&copy; {year} {site.name}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // Track the header's height (it changes with wrapping and text size) so anchor jumps
  // clear it while it's sticky. <html> falls back to 4rem if this doesn't run.
  const header = document.querySelector('header');
  if (header) {
    new ResizeObserver(([entry]) => {
      document.documentElement.style.setProperty(
        '--header-height',
        `${entry.borderBoxSize[0].blockSize}px`,
      );
    }).observe(header);
  }
</script>

