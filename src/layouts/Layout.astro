---
import '../styles/global.css';
import { site } from '../data/site';
import MailingAddress from '../components/MailingAddress.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;
const year = new Date().getFullYear();
const navLinks = [
  { href: '/#mission', label: 'Mission' },
  { href: '/fundraisers', label: 'Fundraisers' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en-CA" class="motion-safe:scroll-smooth tall:scroll-pt-[var(--header-height,4rem)]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="absolute -top-12 left-4 z-100 rounded-lg bg-primary-dark px-4 py-2 text-white focus:top-4"
      href="#main"
    >
      Skip to main content
    </a>

    <header class="top-0 z-50 bg-primary-dark text-white tall:sticky">
      <div
        class="mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4"
      >
        <a class="text-lg font-bold text-white no-underline hover:underline" href="/">
          <span class="md:hidden">{site.shortName}</span>
          <span class="hidden md:inline">{site.name}</span>
        </a>
        <nav aria-label="Primary" class="hidden md:block">
          <ul class="flex flex-wrap gap-x-5 gap-y-1 [&_a]:text-white [&_a:hover]:decoration-2">
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>

        <!-- Below md the links move into a popover, which needs no JavaScript to open or close. -->
        <button
          type="button"
          popovertarget="menu"
          class="flex items-center gap-2 rounded-lg px-3 py-2 font-semibold hover:bg-white/10 md:hidden"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 stroke-current" fill="none" stroke-width="2" stroke-linecap="round">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          Menu
        </button>
        <nav
          id="menu"
          popover
          aria-label="Primary"
          class="inset-y-0 right-0 left-auto m-0 h-auto w-[90%] max-w-none border-0 bg-primary-dark p-0 text-white menu-popover md:hidden"
        >
          <div class="flex justify-end px-5 pt-4">
            <button
              type="button"
              popovertarget="menu"
              popovertargetaction="hide"
              class="flex items-center gap-2 rounded-lg px-3 py-2 font-semibold hover:bg-white/10"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 stroke-current" fill="none" stroke-width="2" stroke-linecap="round">
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
              Close
            </button>
          </div>
          <ul class="px-5 pb-6 text-lg [&_a]:block [&_a]:py-3 [&_a]:text-white [&_a:hover]:decoration-2">
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <footer class="mt-12 border-t border-border bg-surface py-6 text-sm text-muted">
      <div class="mx-auto grid w-full max-w-page gap-6 px-5 sm:grid-cols-2">
        <div>
          <p>&copy; {year} {site.name}</p>
          <p>
            Supporting <a href={site.school.url}>{site.school.name}</a>
          </p>
        </div>
        <div class="space-y-2 sm:text-right">
          <p>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </p>
          <MailingAddress />
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // Track the header's height (it changes with wrapping and text size) so anchor jumps
  // clear it while it's sticky. <html> falls back to 4rem if this doesn't run.
  const header = document.querySelector('header');
  if (header) {
    new ResizeObserver(([entry]) => {
      document.documentElement.style.setProperty(
        '--header-height',
        `${entry.borderBoxSize[0].blockSize}px`,
      );
    }).observe(header);
  }

  // Close the mobile menu when one of its links is clicked, so same-page links like
  // /#mission don't leave it open. HTML can only close a popover from a button.
  const menu = document.getElementById('menu');
  if (menu) {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.hidePopover();
      }
    });
  }
</script>

